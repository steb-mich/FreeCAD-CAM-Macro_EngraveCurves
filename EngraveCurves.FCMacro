import FreeCAD as App
import FreeCADGui as Gui
import Part
import math
import Path
from PySide import QtWidgets, QtCore


doc = App.ActiveDocument

# -----------------------------
# PARAMETERS (GUI DIALOG)
# -----------------------------
class EngraveDialog(QtWidgets.QDialog):
    def __init__(self):
        super().__init__(Gui.getMainWindow())
        self.setWindowTitle("Engrave Curves Parameters")
        self.setMinimumWidth(300)

        layout = QtWidgets.QFormLayout()

        self.total_depth = QtWidgets.QDoubleSpinBox()
        self.total_depth.setRange(0.01, 100.0)
        self.total_depth.setDecimals(2)
        self.total_depth.setSuffix(" mm")
        self.total_depth.setValue(1.7)
        layout.addRow("Total Depth:", self.total_depth)

        self.step_down = QtWidgets.QDoubleSpinBox()
        self.step_down.setRange(0.01, 100.0)
        self.step_down.setDecimals(2)
        self.step_down.setSuffix(" mm")
        self.step_down.setValue(0.2)
        layout.addRow("Step Down:", self.step_down)

        self.safe_height = QtWidgets.QDoubleSpinBox()
        self.safe_height.setRange(0.1, 100.0)
        self.safe_height.setDecimals(2)
        self.safe_height.setSuffix(" mm")
        self.safe_height.setValue(5.0)
        layout.addRow("Safe Height:", self.safe_height)

        self.feed = QtWidgets.QDoubleSpinBox()
        self.feed.setRange(1, 10000)
        self.feed.setDecimals(0)
        self.feed.setSuffix(" mm/min")
        self.feed.setValue(800)
        layout.addRow("Feed Rate:", self.feed)

        self.plunge = QtWidgets.QDoubleSpinBox()
        self.plunge.setRange(1, 10000)
        self.plunge.setDecimals(0)
        self.plunge.setSuffix(" mm/min")
        self.plunge.setValue(200)
        layout.addRow("Plunge Rate:", self.plunge)

        self.step_res = QtWidgets.QDoubleSpinBox()
        self.step_res.setRange(0.01, 10.0)
        self.step_res.setDecimals(2)
        self.step_res.setSuffix(" mm")
        self.step_res.setValue(0.1)
        layout.addRow("Curve Resolution:", self.step_res)

        buttons = QtWidgets.QDialogButtonBox(
            QtWidgets.QDialogButtonBox.Ok | QtWidgets.QDialogButtonBox.Cancel
        )
        buttons.accepted.connect(self.accept)
        buttons.rejected.connect(self.reject)

        main_layout = QtWidgets.QVBoxLayout()
        main_layout.addLayout(layout)
        main_layout.addWidget(buttons)
        self.setLayout(main_layout)

dialog = EngraveDialog()
if dialog.exec() != QtWidgets.QDialog.Accepted:
    raise Exception("Cancelled by user")

TOTAL_DEPTH = dialog.total_depth.value()
STEP_DOWN   = dialog.step_down.value()
SAFE_HEIGHT = dialog.safe_height.value()
FEED        = int(dialog.feed.value())
PLUNGE      = int(dialog.plunge.value())
STEP_RES    = dialog.step_res.value()

# -----------------------------
# FIND ACTIVE JOB
# -----------------------------
job = None

for obj in Gui.Selection.getSelection():
    if hasattr(obj, "Operations"):
        job = obj
        break

if not job:
    raise Exception("Select the Path Job")

# -----------------------------
# FIND SELECTED TOOL
# -----------------------------
tool = None

for obj in Gui.Selection.getSelection():
    if obj.Name.startswith("TC_") or obj.Name.startswith("TC__"):
        tool = obj
        break
    if hasattr(obj, "ToolNumber"):
        tool = obj
        break

if not tool:
    raise Exception("Select a ToolController")

# -----------------------------
# GET SELECTED EDGES
# -----------------------------
edges = []

sel_ex = Gui.Selection.getSelectionEx()

for s in sel_ex:
    for sub in s.SubObjects:
        if isinstance(sub, Part.Edge):
            edges.append(sub)

    # fallback: take edges from whole object
    if not s.SubObjects and hasattr(s.Object, "Shape"):
        edges.extend(s.Object.Shape.Edges)

if not edges:
    raise Exception("No edges found in selection")

# -----------------------------
# SAMPLE CURVES
# -----------------------------
points = []

def sample_edge(edge):
    length = edge.Length
    steps = max(2, int(length / STEP_RES))
    pts = []
    for i in range(steps + 1):
        d = (length / steps) * i
        d = min(d, length)                     # ← clamp to avoid float overshoot
        param = edge.getParameterByLength(d)   # ← convert arc-length → parameter
        pts.append(edge.valueAt(param))         # ← then sample position
    return pts

for e in edges:
    points.extend(sample_edge(e))

# -----------------------------
# SAFE HEIGHT
# -----------------------------
max_z = max(p.z for p in points)
safe_z = max_z + SAFE_HEIGHT

start = points[0]
end   = points[-1]

# -----------------------------
# DEPTH CALCULATION
# -----------------------------
passes = int(TOTAL_DEPTH // STEP_DOWN)
remainder = TOTAL_DEPTH - passes * STEP_DOWN

depths = [STEP_DOWN * (i+1) for i in range(passes)]
if remainder > 0.001:
    depths.append(TOTAL_DEPTH)

# -----------------------------
# BUILD GCODE
# -----------------------------
gcode = ""

# initial safe move
gcode += f"G0 Z{safe_z:.3f}\n"
gcode += f"G0 X{start.x:.3f} Y{start.y:.3f}\n"

for depth in depths:

    # plunge to start point's surface Z minus depth
    plunge_z = start.z - depth
    gcode += f"G1 Z{plunge_z:.3f} F{PLUNGE}\n"

    # follow path — each point uses its own Z from the curve, offset by depth
    for p in points[1:]:
        z = p.z - depth                        # ← surface-following Z
        gcode += f"G1 X{p.x:.3f} Y{p.y:.3f} Z{z:.3f} F{FEED}\n"

    # retract
    gcode += f"G0 Z{safe_z:.3f}\n"

    # return to start XY for next pass
    gcode += f"G0 X{start.x:.3f} Y{start.y:.3f}\n"

# -----------------------------
# CREATE PATH OBJECT
# -----------------------------
#op = doc.addObject("Path::Feature", "EngraveCurves")
#op.Path = Path.Path(gcode)

# attach to job
#job.addObject(op)

# assign tool
#op.ToolController = tool

#doc.recompute()

#print("✅ Engrave path created successfully")

#--
import Path.Op.Engrave as PathEngrave
import Path.Op.Gui.Base as PathOpGui
import Path.Op.Gui.Engrave as PathEngraveGui

# Build resources exactly as FreeCAD does internally
res = PathOpGui.CommandResources(
    "Engrave",
    PathEngrave.Create,
    PathEngraveGui.TaskPanelOpPage,
    "CAM_Engrave",
    "Engrave",
    None,
    "Creates an Engraving toolpath"
)
res.job = job

# Store gcode in a mutable container accessible to the patch
custom_path = Path.Path(gcode)
patch_store = {"path": custom_path, "active": True}

# Patch the class-level execute before creating the op
original_execute = PathEngrave.ObjectEngrave.execute
original_opExecute = PathEngrave.ObjectEngrave.opExecute

def patched_execute(self, obj):
    if patch_store["active"]:
        obj.Path = patch_store["path"]
    else:
        original_execute(self, obj)

def patched_opExecute(self, obj):
    if patch_store["active"]:
        obj.Path = patch_store["path"]
    else:
        original_opExecute(self, obj)

PathEngrave.ObjectEngrave.execute = patched_execute
PathEngrave.ObjectEngrave.opExecute = patched_opExecute

# Create op with full ViewProvider
op = PathOpGui.Create(res)

op.ToolController = tool

# Clear all expressions
for expr in ["StartDepth", "FinalDepth", "StepDown", "ClearanceHeight", "SafeHeight"]:
    try:
        op.setExpression(expr, None)
    except:
        pass

op.Path = custom_path
doc.recompute()

# Restore original methods so other Engrave ops are not affected
PathEngrave.ObjectEngrave.execute = original_execute
PathEngrave.ObjectEngrave.opExecute = original_opExecute

print("✅ Engrave path created successfully")
