import FreeCAD as App
import FreeCADGui as Gui
import Part
import math
import Path

doc = App.ActiveDocument

# -----------------------------
# PARAMETERS (EDIT HERE)
# -----------------------------
TOTAL_DEPTH = 1.7     # mm
STEP_DOWN   = 0.2     # mm
SAFE_HEIGHT = 5.0     # mm above max Z
FEED        = 800     # mm/min
PLUNGE      = 200     # mm/min
STEP_RES    = 0.1     # curve sampling resolution

# -----------------------------
# For debugging
# -----------------------------
for obj in Gui.Selection.getSelection():
    print(obj.Name, obj.TypeId)
    if hasattr(obj, "Proxy"):
        print("  Proxy:", getattr(obj.Proxy, "Type", "no type"))

# -----------------------------
# FIND ACTIVE JOB
# -----------------------------
job = None

for obj in Gui.Selection.getSelection():
    if hasattr(obj, "Operations"):
        job = obj
        break

if not job:
    raise Exception("Select the Path Job")

# -----------------------------
# FIND SELECTED TOOL
# -----------------------------
tool = None

for obj in Gui.Selection.getSelection():
    if obj.Name.startswith("TC_") or obj.Name.startswith("TC__"):
        tool = obj
        break
    if hasattr(obj, "ToolNumber"):
        tool = obj
        break

if not tool:
    raise Exception("Select a ToolController")

# -----------------------------
# GET SELECTED EDGES
# -----------------------------
edges = []

sel_ex = Gui.Selection.getSelectionEx()

for s in sel_ex:
    for sub in s.SubObjects:
        if isinstance(sub, Part.Edge):
            edges.append(sub)

    # fallback: take edges from whole object
    if not s.SubObjects and hasattr(s.Object, "Shape"):
        edges.extend(s.Object.Shape.Edges)

if not edges:
    raise Exception("No edges found in selection")

# -----------------------------
# SAMPLE CURVES
# -----------------------------
points = []

def sample_edge(edge):
    length = edge.Length
    steps = max(2, int(length / STEP_RES))
    pts = []
    for i in range(steps + 1):
        d = (length / steps) * i
        d = min(d, length)                     # ← clamp to avoid float overshoot
        param = edge.getParameterByLength(d)   # ← convert arc-length → parameter
        pts.append(edge.valueAt(param))         # ← then sample position
    return pts

for e in edges:
    points.extend(sample_edge(e))

# -----------------------------
# SAFE HEIGHT
# -----------------------------
max_z = max(p.z for p in points)
safe_z = max_z + SAFE_HEIGHT

start = points[0]
end   = points[-1]

# -----------------------------
# DEPTH CALCULATION
# -----------------------------
passes = int(TOTAL_DEPTH // STEP_DOWN)
remainder = TOTAL_DEPTH - passes * STEP_DOWN

depths = [STEP_DOWN * (i+1) for i in range(passes)]
if remainder > 0.001:
    depths.append(TOTAL_DEPTH)

# -----------------------------
# BUILD GCODE
# -----------------------------
gcode = ""

# initial safe move
gcode += f"G0 Z{safe_z:.3f}\n"
gcode += f"G0 X{start.x:.3f} Y{start.y:.3f}\n"

for depth in depths:

    # plunge to start point's surface Z minus depth
    plunge_z = start.z - depth
    gcode += f"G1 Z{plunge_z:.3f} F{PLUNGE}\n"

    # follow path — each point uses its own Z from the curve, offset by depth
    for p in points[1:]:
        z = p.z - depth                        # ← surface-following Z
        gcode += f"G1 X{p.x:.3f} Y{p.y:.3f} Z{z:.3f} F{FEED}\n"

    # retract
    gcode += f"G0 Z{safe_z:.3f}\n"

    # return to start XY for next pass
    gcode += f"G0 X{start.x:.3f} Y{start.y:.3f}\n"

# -----------------------------
# CREATE PATH OBJECT
# -----------------------------
#op = doc.addObject("Path::Feature", "EngraveCurves")
#op.Path = Path.Path(gcode)

# attach to job
#job.addObject(op)

# assign tool
#op.ToolController = tool

#doc.recompute()

#print("✅ Engrave path created successfully")

#--
import Path.Op.Engrave as PathEngrave
import Path.Op.Gui.Base as PathOpGui
import Path.Op.Gui.Engrave as PathEngraveGui

# Build resources exactly as FreeCAD does internally
res = PathOpGui.CommandResources(
    "Engrave",
    PathEngrave.Create,
    PathEngraveGui.TaskPanelOpPage,
    "CAM_Engrave",
    "Engrave",
    None,
    "Creates an Engraving toolpath"
)
res.job = job

# Store gcode in a mutable container accessible to the patch
custom_path = Path.Path(gcode)
patch_store = {"path": custom_path, "active": True}

# Patch the class-level execute before creating the op
original_execute = PathEngrave.ObjectEngrave.execute
original_opExecute = PathEngrave.ObjectEngrave.opExecute

def patched_execute(self, obj):
    if patch_store["active"]:
        obj.Path = patch_store["path"]
    else:
        original_execute(self, obj)

def patched_opExecute(self, obj):
    if patch_store["active"]:
        obj.Path = patch_store["path"]
    else:
        original_opExecute(self, obj)

PathEngrave.ObjectEngrave.execute = patched_execute
PathEngrave.ObjectEngrave.opExecute = patched_opExecute

# Create op with full ViewProvider
op = PathOpGui.Create(res)

op.ToolController = tool

# Clear all expressions
for expr in ["StartDepth", "FinalDepth", "StepDown", "ClearanceHeight", "SafeHeight"]:
    try:
        op.setExpression(expr, None)
    except:
        pass

op.Path = custom_path
doc.recompute()

# Restore original methods so other Engrave ops are not affected
PathEngrave.ObjectEngrave.execute = original_execute
PathEngrave.ObjectEngrave.opExecute = original_opExecute

print("✅ Engrave path created successfully")

#---debug
job = [o for o in App.ActiveDocument.Objects if hasattr(o, "Operations")][0]
op = job.Operations.Group[-1]
print("Op name:", op.Name)
print("Path size:", op.Path.Size)
print("Proxy type:", type(op.Proxy))
print("VP Proxy type:", type(op.ViewObject.Proxy))
print("Expressions:")
for expr in op.ExpressionEngine:
    print(" ", expr)
